# 阿里云百炼 API key（推荐，国内可用）：https://bailian.console.aliyun.com 获取
# 填了就用通义千问生成锐评和报告
DASHSCOPE_API_KEY=
# 可选：换模型。锐评和赛后报告默认都用 qwen3.7-plus
# QWEN_MODEL=qwen3.7-plus
# QWEN_REPORT_MODEL=qwen3.7-plus
# 截图识别用的视觉模型
# QWEN_VL_MODEL=qwen3-vl-plus

# Riot 开发者 key：https://developer.riotgames.com 登录后获取（每 24 小时过期）
RIOT_API_KEY=

# Claude API key（可选，没填百炼 key 时才会用）：https://console.anthropic.com 获取
ANTHROPIC_API_KEY=

# 可选：端口
# PORT=3000
